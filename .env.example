# Valores reais ficam no cofre do GVP / Vercel — NUNCA aqui.
# O gvp lê este arquivo para saber quais variáveis o site precisa.

# Senha do painel /admin  →  gvp admin setup  (Enter = gera uma senha forte)
ADMIN_PASSWORD=
# Token da Wapito (começa com wpt_)  →  gvp env set WAPITO_API_TOKEN
WAPITO_API_TOKEN=
# Protege o envio automático das 9h  →  o gvp gera sozinho
CRON_SECRET=

# --- Opcionais (deixe sem nada; só use se precisar mudar) ---
# WAPITO_API_URL      padrão: https://api.wapito.com/v1
# WAPITO_SEND_PATH / WAPITO_FIELD_PHONE / WAPITO_FIELD_TEXT   formato fixo da Wapito
#                     (o sistema descobre sozinho na 1ª mensagem)
# Banco Upstash Redis: a Vercel cria as variáveis sozinha ao conectar em Storage
