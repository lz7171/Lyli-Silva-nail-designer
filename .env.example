# Copie estes nomes para: Vercel > seu projeto > Settings > Environment Variables
# NUNCA coloque valores reais neste arquivo nem suba senhas/tokens para o GitHub.

# --- Obrigatórias ---
ADMIN_PASSWORD=           # senha do painel /admin (mínimo 6 caracteres)
WAPITO_API_TOKEN=         # token da Wapito (começa com wpt_)

# --- Recomendada ---
CRON_SECRET=              # qualquer texto longo e aleatório (protege o envio automático)

# --- Banco (a Vercel preenche sozinha ao conectar o Upstash Redis em Storage) ---
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN  (ou KV_REST_API_URL / KV_REST_API_TOKEN)

# --- Opcionais (só mude se a Wapito pedir algo diferente) ---
# WAPITO_API_URL=https://api.wapito.com/v1
# WAPITO_SEND_PATH=/messages
# WAPITO_FIELD_PHONE=to
# WAPITO_FIELD_TEXT=message
