# Copie este arquivo para .env.local no Vercel ou no ambiente local
# No painel do Vercel, adicione estas variáveis de ambiente:

# Banco da agenda
UPSTASH_REDIS_REST_URL=https://seu-upstash-url
UPSTASH_REDIS_REST_TOKEN=seu-token

# Painel administrativo
ADMIN_PASSWORD=sua_senha_super_segura
ADMIN_SECRET=sua_chave_aleatoria_com_mais_de_16_caracteres

# Também funciona com nomes alternativos:
# REST_URL=https://...
# REST_TOKEN=...
# REST_API_URL=https://...
# REST_API_TOKEN=...
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
